{
  "name": "@senderos/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": "./src/index.ts",
  "bin": {
    "senderos": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --isolate",
    "coverage": "bun test --isolate --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir coverage"
  },
  "dependencies": {
    "@senderos/senderos": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "latest"
  }
}
