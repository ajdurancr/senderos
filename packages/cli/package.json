{
  "name": "senderos",
  "private": false,
  "version": "0.1.2",
  "description": "Command-line interface for the Senderos engineering orchestration platform.",
  "type": "module",
  "bin": {
    "senderos": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajdurancr/senderos.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ajdurancr/senderos#readme",
  "bugs": {
    "url": "https://github.com/ajdurancr/senderos/issues"
  },
  "keywords": [
    "senderos",
    "cli",
    "orchestration",
    "ai-agents",
    "developer-tools"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build ./src/index.ts --target=bun --outfile=./dist/index.js --external '@libsql/*' --external 'drizzle-orm/*' && cp -R ../core/drizzle ./dist/drizzle && cp -R ../core/src/bootstrap/agents ./dist/agents && cp -R ../core/src/bootstrap/senderos ./dist/senderos && cp -R ./src/skills ./dist/skills",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun ../../scripts/run-with-test-runtime.ts bun run test:raw",
    "test:raw": "bun test --isolate --timeout=15000",
    "coverage": "bun ../../scripts/run-with-test-runtime.ts bun run coverage:raw",
    "coverage:raw": "bun test --isolate --timeout=15000 --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir coverage && bun ../../scripts/check-bun-coverage.ts 100 100 100",
    "package:check": "bun run src/scripts/check-package.ts",
    "release:check": "bun run typecheck && bun run --cwd ../.. coverage && bun run build && bun run package:check",
    "prepack": "bun run build",
    "prepublishOnly": "bun run release:check"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@senderos/core": "workspace:*",
    "typescript": "^5.9.3",
    "@types/bun": "latest"
  }
}
