{
  "name": "senderos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --isolate",
    "test:unit": "find ./src -name '*.test.ts' ! -path './src/integration/*.integration.test.ts' -print0 | xargs -0 bun test --isolate",
    "test:integration": "rm -rf ./.tmp/integration-tests && mkdir -p ./.tmp/integration-tests && bun test --isolate ./src/integration/*.integration.test.ts && rm -rf ./.tmp/integration-tests",
    "coverage": "bun test --isolate --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir coverage && bun run scripts/check-coverage.ts 90 coverage"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "latest"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4"
  }
}
