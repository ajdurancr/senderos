---
const { headings } = Astro.props as { headings: { depth: number; slug: string; text: string }[] };
const filtered = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<aside class="doc-toc">
  {filtered.length > 0 && (
    <>
      <div class="toc-title">On this page</div>
      <ul>
        {filtered.map((heading) => (
          <li class:list={[heading.depth === 3 && 'nested']}><a href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ul>
    </>
  )}
  <div class="toc-feedback">
    <span>Found an issue?</span>
    <a href="https://github.com/ajdurancr/senderos/issues/new" target="_blank" rel="noreferrer">Tell us →</a>
  </div>
</aside>
