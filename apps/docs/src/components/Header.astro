---
import { SITE } from '@/data/site';
const pathname = Astro.url.pathname;
const docsActive = pathname.startsWith('/docs');
---

<header class="sticky top-0 z-40 border-b border-[rgba(255,255,255,0.06)] bg-[rgba(8,12,26,0.78)] backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4">
    <a href="/" class="flex items-center gap-3 no-underline">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--accent-soft)] text-lg font-bold text-[var(--accent)]">S</div>
      <div>
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-[var(--muted)]">Senderos</div>
        <div class="text-base font-semibold text-[var(--text)]">Docs</div>
      </div>
    </a>

    <nav class="flex items-center gap-3 text-sm">
      <a
        href="/docs/introduction"
        class:list={[
          'rounded-full px-4 py-2 no-underline transition',
          docsActive
            ? 'bg-[rgba(255,255,255,0.06)] text-[var(--text)]'
            : 'text-[var(--muted)] hover:bg-[rgba(255,255,255,0.04)] hover:text-[var(--text)]'
        ]}
      >
        Documentation
      </a>
      <a
        class="rounded-full px-4 py-2 text-[var(--muted)] no-underline transition hover:bg-[rgba(255,255,255,0.04)] hover:text-[var(--text)]"
        href={SITE.repoUrl}
        target="_blank"
        rel="noreferrer"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>
