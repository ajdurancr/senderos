---
import { SITE } from '@/data/site';
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[rgba(11,16,32,0.86)] backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4">
    <a href="/" class="flex items-center gap-3 no-underline">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--accent-soft)] text-lg font-bold text-[var(--accent)]">S</div>
      <div>
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-[var(--muted)]">Senderos</div>
        <div class="text-base font-semibold text-[var(--text)]">Docs</div>
      </div>
    </a>

    <nav class="flex items-center gap-5 text-sm">
      <a class:list={["no-underline", pathname.startsWith('/docs') ? 'text-[var(--text)]' : 'text-[var(--muted)]']} href="/docs/introduction">Documentation</a>
      <a class="text-[var(--muted)] no-underline hover:text-[var(--text)]" href={SITE.repoUrl} target="_blank" rel="noreferrer">GitHub</a>
    </nav>
  </div>
</header>
