---
import { NAVIGATION } from '@/data/site';
const { currentSlug } = Astro.props as { currentSlug: string };
const base = `${import.meta.env.BASE_URL}/`;
const activeItem = NAVIGATION.flatMap((group) => group.items).find((item) => item.slug === currentSlug);
---

<details class="mobile-doc-nav">
  <summary><span>{activeItem?.section ?? 'Documentation'}</span><strong>{activeItem?.title ?? 'Browse docs'}</strong></summary>
  <nav aria-label="Mobile documentation navigation">
    {NAVIGATION.map((group) => (
      <section>
        <h2>{group.section}</h2>
        {group.items.map((item) => <a class:list={[item.slug === currentSlug && 'active']} href={`${base}docs/${item.slug}`}>{item.title}</a>)}
      </section>
    ))}
  </nav>
</details>

<aside class="doc-sidebar">
  <nav aria-label="Documentation navigation">
    {NAVIGATION.map((group) => (
      <section>
        <h2>{group.section}</h2>
        <ul>
          {group.items.map((item) => (
            <li><a class:list={[item.slug === currentSlug && 'active']} aria-current={item.slug === currentSlug ? 'page' : undefined} href={`${base}docs/${item.slug}`}>{item.title}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
</aside>
