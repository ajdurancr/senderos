---
import Sidebar from '@/components/Sidebar.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { FLAT_NAV, getNeighbors } from '@/data/site';

const { title, description, currentSlug, headings = [] } = Astro.props as {
  title: string;
  description: string;
  currentSlug: string;
  headings?: { depth: number; slug: string; text: string }[];
};

const neighbors = getNeighbors(currentSlug);
const current = FLAT_NAV.find((item) => item.slug === currentSlug);
const base = `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={`${title} · Senderos`} description={description}>
  <div class="docs-frame">
    <Sidebar currentSlug={currentSlug} />

    <main class="docs-main">
      <div class="doc-breadcrumb">
        <a href={`${base}docs/introduction`}>Docs</a><span>/</span><span>{current?.section}</span>
      </div>
      <article>
        <header class="article-header">
          <p>{current?.section}</p>
          <h1>{title}</h1>
          <div>{description}</div>
        </header>

        <div class="doc-content"><slot /></div>

        <nav class="page-neighbors" aria-label="Previous and next pages">
          {neighbors.previous ? (
            <a href={`${base}docs/${neighbors.previous.slug}`} class="previous">
              <span>← Previous</span><strong>{neighbors.previous.title}</strong>
            </a>
          ) : <span />}
          {neighbors.next ? (
            <a href={`${base}docs/${neighbors.next.slug}`} class="next">
              <span>Next →</span><strong>{neighbors.next.title}</strong>
            </a>
          ) : <span />}
        </nav>
      </article>
    </main>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
